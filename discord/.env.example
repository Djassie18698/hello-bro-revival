# Copy to .env (never commit it). Load with: node --env-file=.env bot.js
DISCORD_TOKEN=
ANTHROPIC_API_KEY=
# Your own Discord user id(s), comma separated. Only these people can give the bot orders.
OWNER_IDS=
# Optional: also accept orders in this channel (name or id) without having to @mention the bot
CONTROL_CHANNEL=
# Optional: cheaper/faster model, e.g. claude-sonnet-5-5 or claude-haiku-5-5. Default claude-opus-5-5
CLAUDE_MODEL=
